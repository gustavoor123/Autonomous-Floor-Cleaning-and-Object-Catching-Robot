<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="depth_camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="depth_camera_link"/>
        <origin xyz="0.15 0 0.068" rpy="0 0 0"/>
    </joint>

    <link name="depth_camera_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.03 0.09 0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.03 0.09 0.025"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.061"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
        </inertial>
    </link>

    <!-- Standard ROS optical frame -->
    <joint name="depth_camera_optical_joint" type="fixed">
        <parent link="depth_camera_link"/>
        <child link="depth_camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="depth_camera_link_optical"/>

    <gazebo reference="depth_camera_link">
        <material>Gazebo/Black</material>

        <sensor name="depth_camera" type="depth_camera">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <always_on>true</always_on>
            <update_rate>6</update_rate>
            <topic>depth_camera</topic>
            <gz_frame_id>depth_camera_link_optical</gz_frame_id>
            <camera>
                <horizontal_fov>1.274</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.2</near>
                    <far>9.0</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.2</near>
                        <far>9.0</far>
                    </clip>
                </depth_camera>
            </camera>
        </sensor>
    </gazebo>

</robot>
